# EditorConfig — applies to every file in the repository.
# Reference: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown,yml,yaml,json,xml,props,targets}]
indent_size = 2

[*.cs]
# Modern C# style
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Using directives
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Naming
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Code-quality rules enforced at build
dotnet_diagnostic.CA1303.severity = suggestion      # Don't pass literals as localized resources (app-level, not strict)
dotnet_diagnostic.CA1305.severity = suggestion      # Specify IFormatProvider
dotnet_diagnostic.CA1307.severity = suggestion      # Specify StringComparison explicitly
dotnet_diagnostic.CA1308.severity = none            # We normalize strings to lowercase on purpose (emails / slugs)
dotnet_diagnostic.CA1310.severity = suggestion      # Specify StringComparison for string.Compare
dotnet_diagnostic.CA1716.severity = warning         # No namespace conflicts with keywords
dotnet_diagnostic.CA1032.severity = none            # Standard exception constructors — we use rich context constructors instead
dotnet_diagnostic.CA1000.severity = suggestion      # Static members on generic types — Result<T>.Success is fine for our use
dotnet_diagnostic.CA1062.severity = none            # Parameter null-checks — handled by nullable + ArgumentNullException.ThrowIfNull on critical paths
dotnet_diagnostic.CA1724.severity = none            # Type name conflicts with namespace — common DI class name, not strict
dotnet_diagnostic.CA1873.severity = suggestion      # High-cost log arg evaluation — Serilog message templates already defer formatting
dotnet_diagnostic.CA1812.severity = none            # Avoid uninstantiated classes — middleware is instantiated by UseMiddleware<T>() reflection
dotnet_diagnostic.CA1515.severity = none            # Public types should be internal — too noisy at app root level
dotnet_diagnostic.CA1031.severity = none            # Catch-all exceptions for fire-and-forget email delivery (deliberate)
dotnet_diagnostic.CA1711.severity = none            # Rename type not ending in 'EventHandler' — MediatR naming convention
dotnet_diagnostic.CA1848.severity = suggestion      # Use LoggerMessage delegates (perf micro-opt; OK in app code)
dotnet_diagnostic.CA2007.severity = suggestion      # Configure await (good for libraries; not strict for app code)
dotnet_diagnostic.IDE0005.severity = suggestion     # Remove unused usings
dotnet_diagnostic.IDE0011.severity = none           # Add braces to if — too noisy for guard clauses
dotnet_diagnostic.IDE0060.severity = suggestion     # Remove unused parameters
dotnet_diagnostic.IDE0090.severity = suggestion     # Use new(...)
dotnet_diagnostic.SA1623.severity = none            # doc-typing rule that's noisy on records
dotnet_diagnostic.CA1512.severity = suggestion      # Use ArgumentOutOfRangeException.ThrowIf* (perf)

# Trivial newlines
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# --- Test project overrides ---
# Test method names use the idiomatic "Subject_Method_Expected" pattern with underscores.
# Tests often pass null where a non-null is expected (theory data), which is fine.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1851.severity = none
dotnet_diagnostic.xUnit1012.severity = none
dotnet_diagnostic.xUnit2003.severity = none
dotnet_diagnostic.CA2234.severity = none            # GetAsync(string) overload — fine for tests
dotnet_diagnostic.CA1002.severity = none            # List<T> in test doubles — fine
dotnet_diagnostic.CA1823.severity = none            # Unused test fields — common in test classes
dotnet_diagnostic.CA2000.severity = none            # Logger disposal in tests — fine, short-lived process

# --- Migrations folder (auto-generated by EF Core tooling) ---
[src/NexaFlow.Infrastructure/Persistence/Migrations/**.cs]
generated_code = true
dotnet_diagnostic.IDE0161.severity = none           # File-scoped namespace — generated
dotnet_diagnostic.CA1861.severity = none            # Constant array arguments — generated
dotnet_diagnostic.CA1303.severity = none
dotnet_analyzer_diagnostic.severity = none
